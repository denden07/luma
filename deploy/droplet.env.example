# Copy to /etc/luma/luma.env (root:luma, mode 0640); replace placeholders privately.
# Client VITE_* values belong at BUILD time, not in this runtime file.
PORT=3000
HOST=127.0.0.1
USE_HTTPS=false
DATABASE_URL=postgresql://luma:URL_ENCODED_DATABASE_PASSWORD@127.0.0.1:5432/luma
UPLOAD_DIR=/srv/luma/uploads
ALLOWED_ORIGINS=https://example.com

# Verify R2 reads, uploads, downloads and deletion before accepting public traffic.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_PRIVATE_BUCKET

# One-time value only during administrator bootstrap; remove afterward.
# ADMIN_BOOTSTRAP_SECRET=YOUR_LONG_RANDOM_SECRET
