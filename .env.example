VITE_APP_MODE=local
VITE_DATA_PROVIDER=local
VITE_API_BASE_URL=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/madetogether
PORT=3000
UPLOAD_DIR=./uploads
USE_HTTPS=false
ALLOWED_ORIGINS=https://localhost:5173,https://192.168.1.90:5173
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# Local uses filesystem storage. Set to r2 only in Vercel production.
STORAGE_PROVIDER=local
